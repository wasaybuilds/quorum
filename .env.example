# Server-side only. Get a key at https://console.anthropic.com
# Without a key the app runs on built-in offline answers.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the default model
# ANTHROPIC_MODEL=

# Accounts (optional). Postgres connection string; without it the app runs as a
# demo workspace only and "Sign in with Google" is disabled.
DATABASE_URL=
# Random string used to encrypt stored Google tokens (e.g. `openssl rand -base64 32`)
AUTH_SECRET=

# Optional: Google sign-in + Calendar (read-only). Create an OAuth client (type: Web application)
# in Google Cloud Console and add <your-origin>/api/calendar/callback as a redirect URI.
# Without these, the Upcoming page uses a demo calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional overrides
# GOOGLE_REDIRECT_URI=https://your-app.example.com/api/calendar/callback
